<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ecommerce Smoke Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.sta.testng.listener.CustomTestNGListener" />
    </listeners>

    <test name="Smoke Group Tests">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
        <classes>
            <class name="com.sta.testng.EcommerceTestNGSuite" />
        </classes>
    </test>
</suite>

